# Copy to .env for deploy/compose.local.yaml (use --project-directory .); real keys are required before starting OpenAlbert.
TELEGRAM_BOT_TOKEN=
# Widget availability: auto caches rejection for 1h; on always probes; off sends text.
TELEGRAM_WIDGETS=auto
# Optional Bot API server override (empty uses official endpoint).
TELEGRAM_BASE_URL=
# Allowed private-chat user IDs (positive, comma-separated). Empty rejects startup.
TELEGRAM_ALLOWED_USER_IDS=
# Owner sees saved group history from their private chat. Empty uses the first allowed ID.
TELEGRAM_OWNER_USER_ID=
# Allowed group IDs (negative); all delivered non-bot participants may interact. Empty: private only.
TELEGRAM_ALLOWED_GROUP_IDS=
# Optional negative supergroup ID for the owner-only Workspace with forum topics. Empty disables workspace mode.
TELEGRAM_WORKSPACE_GROUP_ID=
# Accept bot messages like human messages in allowed groups; private chats are unchanged.
TELEGRAM_ALLOW_BOT_MESSAGES=false
# profiles (default): each role uses its TOML adapter/model; no automatic billing fallback.
# Legacy api_key, siwc (plan only), auto (plan then API) require API-only TOML profiles.
OPENAI_AUTH_MODE=profiles
# Legacy siwc/auto initial model only. Ignored in profiles mode: configure each TOML profile model.
OPENAI_SIWC_MODEL=
# Local retry cooldown, not the ChatGPT plan reset time.
OPENAI_LANE_COOLDOWN=15m
# Copy deploy/models.example.toml to models.toml and choose models/capabilities there.
# Host path mounted read-only by Compose; missing files fail startup.
LLM_CONFIG_HOST_FILE=./models.toml
# Path for go run outside Compose (Compose sets the container path itself).
LLM_CONFIG_FILE=./models.toml
# Credential referenced by api_key_env in the example profile.
# Additional credential names belong in optional models.env beside .env.
LLM_API_KEY=
# Independent speech recognition. Compose connects to the bundled CPU service.
# Remove local-stt from COMPOSE_PROFILES for a single-container deployment or external STT.
COMPOSE_PROFILES=local-stt
# For go run outside Compose use a separately reachable STT URL, or leave empty.
# An explicitly empty STT_BASE_URL disables STT in Compose as well.
STT_BASE_URL=http://stt:8080/v1
STT_MODEL=nemotron-3.5
STT_API_KEY=
# Change whenever weights, runtime, language or normalization settings change.
STT_REVISION=ea30d66d-q8-nemo2bdfb03b-ru-pcm16-v1
# Download/check the pinned Q8 model only on explicitly starting the container.
STT_DOWNLOAD_MODEL=true
# Initial limits, not verified minimum system requirements.
STT_CPUS=2
STT_THREADS=2
STT_MEMORY_LIMIT=3g
# Optional voice replies. Add local-tts to COMPOSE_PROFILES and set
# TTS_BASE_URL=http://tts:8080/v1 to enable the bundled Piper service.
TTS_BASE_URL=
TTS_MODEL=piper
TTS_VOICE=ru_RU-dmitri-medium
TTS_API_KEY=
TTS_CPUS=2
TTS_MEMORY_LIMIT=1g
# Optional web search provider: leave empty to auto-select the sole configured provider,
# or set "exa" or "yandex" explicitly when both credentials exist. Leave all credentials
# empty to disable web_search (public web_read remains available).
WEB_SEARCH_PROVIDER=
EXA_API_KEY=
# Optional test or proxy endpoint; empty uses https://api.exa.ai/search.
EXA_SEARCH_URL=
# Monthly Exa credit budget in USD shown in the Inspector limits dashboard (Starter plan: 10).
EXA_MONTHLY_BUDGET_USD=10
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Optional test or proxy endpoint; empty uses Yandex Search API v2.
YANDEX_SEARCH_URL=

SESSION_IDLE_TIMEOUT=30m
# Auto-close orphaned active coding sessions after this much inactivity; 0 disables.
CODING_SESSION_STALE_TIMEOUT=24h
MAX_AGENT_STEPS=100
# Public websites in local Chromium; 5 instances total, at most 4 background.
BROWSER_ENABLED=true
# Optional Chromium binary path (empty discovers it on PATH).
BROWSER_EXECUTABLE=
# Docker Desktop requires this; set false on hosts supporting the Chromium sandbox.
BROWSER_NO_SANDBOX=true
TASK_MIN_INTERVAL=5m
# 0 disables proactive check-ins, but scheduled tasks continue.
INITIATIVE_INTERVAL=30m
# Autonomous memory consolidation interval; 0 disables scheduled consolidation.
MEMORY_CONSOLIDATION_INTERVAL=24h

# For go run ./apps/backend/cmd/openalbert outside Docker (Compose mounts ./data at /data):
DATA_DIR=./data
# Optional overrides; empty derives from DATA_DIR:
# DATABASE_PATH=./data/openalbert.db
# ARTIFACTS_DIR=./data/artifacts
# KNOWLEDGE_DIR=./data/knowledge
# OPENAI_TOKEN_STORE=./data/chatgpt/credentials.json
SOUL_FILE=
HTTP_ADDR=127.0.0.1:8080
# Browser-visible inspector base URL used by diagnostic links in logs.
INSPECTOR_PUBLIC_URL=http://localhost:8080/inspect/

# Optional user-managed computer. Empty leaves computer tools disabled.
# Albert prepares/updates its runner automatically; the user manages the machine.
COMPUTER_SSH_ADDRESS=
COMPUTER_SSH_USER=albert
# Set exactly one auth method when COMPUTER_SSH_ADDRESS is nonempty.
COMPUTER_SSH_PASSWORD=
# Put the key in computer/client/ and use its container path:
COMPUTER_SSH_KEY_FILE=
# Example: COMPUTER_SSH_KEY_FILE=/data/computer/id_ed25519
# Server host keys are intentionally not verified; no known_hosts is required.
# See docs/computer.md for a separate local computer and migration instructions.

# Owner desktop API bearer token (minimum 32 random bytes). Empty disables it.
DESKTOP_API_TOKEN=
