# Copy to .env for compose.yaml; fill every required value before starting.
# Workflow derives the prefix automatically from the GitHub repository, in lowercase.
OPENALBERT_IMAGE_PREFIX=ghcr.io/your-owner/openalbert
# Prefer sha-<full 40-character commit SHA> to pin one tested build of all components.
OPENALBERT_IMAGE_TAG=master
TELEGRAM_BOT_TOKEN=
# Optional Bot API server override (empty uses official endpoint).
TELEGRAM_BASE_URL=
# Allowed private-chat user IDs (positive, comma-separated). Empty rejects startup.
TELEGRAM_ALLOWED_USER_IDS=
# Owner sees saved group history from their private chat. Empty uses the first allowed ID.
TELEGRAM_OWNER_USER_ID=
# Allowed group IDs (negative); all delivered non-bot participants may interact. Empty: private only.
TELEGRAM_ALLOWED_GROUP_IDS=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Independent speech recognition. Compose connects to the bundled CPU service.
# Clear COMPOSE_PROFILES when using external STT or disabling speech recognition.
COMPOSE_PROFILES=local-stt
# For go run outside Compose use a separately reachable STT URL, or leave empty.
# An explicitly empty STT_BASE_URL disables STT in Compose as well.
STT_BASE_URL=http://stt:8080/v1
STT_MODEL=nemotron-3.5
STT_API_KEY=
# Change whenever weights, runtime, language or normalization settings change.
STT_REVISION=ea30d66d-q8-nemo2bdfb03b-ru-pcm16-v1
# Download/check the pinned Q8 model only on explicitly starting the container.
STT_DOWNLOAD_MODEL=true
# Initial limits, not verified minimum system requirements.
STT_CPUS=2
STT_THREADS=2
STT_MEMORY_LIMIT=3g
# Optional: leave BOTH empty to run without web search. Public URL reading remains available.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Optional test or proxy endpoint; empty uses Yandex Search API v2.
YANDEX_SEARCH_URL=

# Required deployment credentials. Use distinct, private values.
# POSTGRES_PASSWORD must be URL-safe because it is interpolated into DATABASE_URL.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=openalbert
TEMPORAL_NAMESPACE=default
# Temporal Web UI, loopback only; no login is required locally.
TEMPORAL_UI_HOST_PORT=8233
TEMPORAL_TASK_QUEUE=openalbert
SESSION_IDLE_TIMEOUT=30m
MAX_AGENT_STEPS=100
# Public websites in local Chromium; 5 instances total, at most 4 background.
BROWSER_ENABLED=true
# Optional Chromium binary path (empty discovers it on PATH).
BROWSER_EXECUTABLE=
# Set false when the host supports the Chromium sandbox; verify browser operation.
BROWSER_NO_SANDBOX=true
TASK_MIN_INTERVAL=5m
# 0 disables proactive check-ins, but scheduled tasks continue.
INITIATIVE_INTERVAL=30m
# Logging URL resolved by Docker daemon, not by a container.
DOCKER_LOGS_GATEWAY_URL=http://127.0.0.1:9429
# Temporal housekeeping INFO messages are verbose; use info while diagnosing its internals.
TEMPORAL_LOG_LEVEL=warn
# Browser-visible inspector URL used in diagnostic links.
INSPECTOR_PUBLIC_URL=http://localhost:8080/inspect/
# Omit to use the bundled VictoriaLogs; set empty to disable owner-only logs_search.
# VICTORIALOGS_URL=
